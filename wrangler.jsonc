{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mybooksx",
  "main": "mybooksx-website/src/server/worker.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mybooksx_prod_db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "mybooksx-website/src/server/db"
    }
  ],
  "vars": {
    "APP_URL": "https://mybooksx.com",
    "GOOGLE_REDIRECT_URI": "https://mybooksx.com/api/auth/google/callback",
    "ADMIN_EMAIL": "mybooksxofficial@gmail.com"
  }
}

