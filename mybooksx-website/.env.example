# ==============================================================================
# MyBooksX Environment Variables & Google Cloud OAuth 2.0 Configuration
# ==============================================================================

# Google Cloud OAuth 2.0 Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# For local dev: http://localhost:5173/api/auth/google/callback
# For production Cloudflare: https://mybooksx.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Application URL
APP_URL=http://localhost:5173

# Server Session & Admin Configuration
ADMIN_KEY=deepmehta@mybooks
ADMIN_EMAIL=mybooksxofficial@gmail.com
